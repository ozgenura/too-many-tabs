# Public site origin — canonical links, og:url, og:image, sitemap.
VITE_SITE_URL="https://toomanytabs.dev"

# Search engines are opted OUT unless this is exactly "true".
# Leave unset while the site is still being filled in; set it on the
# production build at launch.
VITE_ALLOW_INDEXING="false"

# Notify-list backend (Supabase). Only the publishable key is needed:
# the site never authenticates, it just inserts into email_subscribers.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Deploy credential — an alternative to `wrangler login`.
# Dashboard → My Profile → API Tokens → "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""

# Easter-egg tunables (see src/lib/egg-config.ts)
# VITE_IDLE_TIMEOUT_MS="180000"
# VITE_SPRITE_PROBABILITY="0.05"
